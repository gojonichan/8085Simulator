## Example Programs

### 1. Add Two Numbers

```asm
; Adds 25H and 1AH, stores result at 3000H
    ORG 2000H

    MVI A, 25H          ; Load first number into A
    MVI B, 1AH          ; Load second number into B
    ADD B                ; A = A + B = 3FH
    STA 3000H           ; Store result at 3000H
    HLT
```

### 2. Find Smallest Number in an Array

```asm
; Array count at 2050H, data from 2051H
; Result (smallest) stored at 2060H
    ORG 2000H

    LDA 2050H           ; Load the count
    DCR A                ; N-1 comparisons needed
    MOV C, A             ; C = loop counter
    LXI H, 2051H        ; HL points to first element
    MOV A, M             ; A = first element (assume smallest)

FIND:
    INX H                ; Point to next element
    CMP M                ; Compare A with current element
    JC SKIP              ; If A < element, keep A (carry set)
    MOV A, M             ; New smallest found
SKIP:
    DCR C                ; Decrement counter
    JNZ FIND             ; Repeat
    STA 2060H            ; Store smallest at 2060H
    HLT

; Test data
    ORG 2050H
    DB 05H                          ; Count = 5
    DB 34H, 78H, 12H, 9AH, 56H    ; Array data
```

### 3. Bubble Sort (Ascending)

```asm
; Sorts N bytes starting at 2051H, count at 2050H
    ORG 2000H

    LDA 2050H           ; Load count N
    DCR A                ; N-1 passes needed
    MOV C, A             ; C = outer loop counter

OUTER:
    MOV D, C             ; D = inner loop counter
    LXI H, 2051H        ; Point to start of array

INNER:
    MOV A, M             ; Load current element
    INX H
    CMP M                ; Compare with next element
    JC NOSWAP            ; If current < next, no swap
    JZ NOSWAP            ; If equal, no swap

    MOV B, M             ; B = next element
    MOV M, A             ; Store current in next position
    DCX H
    MOV M, B             ; Store next in current position
    INX H

NOSWAP:
    DCR D
    JNZ INNER
    DCR C
    JNZ OUTER
    HLT

; Test data
    ORG 2050H
    DB 05H                          ; Count = 5
    DB 64H, 19H, 2DH, 07H, 48H    ; Array: 100, 25, 45, 7, 72
```

### 4. 8-bit Multiplication (Repeated Addition)

```asm
; Multiplies values at 2050H and 2051H
; 16-bit result stored at 2052H-2053H
    ORG 2000H

    LDA 2050H           ; Load multiplicand
    MOV B, A
    LDA 2051H           ; Load multiplier
    MOV C, A
    MVI A, 00H           ; Clear accumulator
    MVI D, 00H           ; Clear D for carry

LOOP:
    ADD B                ; Add multiplicand
    JNC NOCARRY
    INR D                ; Increment high byte on overflow
NOCARRY:
    DCR C                ; Decrement counter
    JNZ LOOP

    STA 2052H            ; Store low byte of result
    MOV A, D
    STA 2053H            ; Store high byte of result
    HLT

; Data
    ORG 2050H
    DB 05H               ; Multiplicand = 5
    DB 04H               ; Multiplier = 4
```

### 5. Subroutine Call — Sum of Array

```asm
; Sums 5 bytes at 2050H using a subroutine, result at 2060H
    ORG 2000H

    LXI SP, 20FFH       ; Initialize stack pointer
    LXI H, 2050H        ; Array address
    MVI C, 05H           ; Count

    CALL SUM             ; Call subroutine
    STA 2060H            ; Store the sum
    HLT

; Subroutine: SUM
; Input:  HL = array address, C = count
; Output: A = sum
SUM:
    MVI A, 00H           ; Clear accumulator
ADDNXT:
    ADD M                ; Add array element
    INX H                ; Next element
    DCR C
    JNZ ADDNXT
    RET                  ; Return to caller

; Data
    ORG 2050H
    DB 10H, 20H, 30H, 40H, 50H
```

### 6. I/O Port Demo

```asm
; Reads from port 01H, rotates left twice, outputs to port 02H
    ORG 2000H

    IN 01H               ; Read from input port 1
    RLC                   ; Rotate left
    RLC                   ; Rotate left again
    OUT 02H              ; Output to port 2
    HLT
```

